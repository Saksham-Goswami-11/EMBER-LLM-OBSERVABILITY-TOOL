# Copy to .env before `docker compose up`:  cp .env.example .env
# .env is gitignored — never commit a real key.

# The API key your instrumented apps send as `Authorization: Bearer <key>`.
# Pick any string of 16+ characters. Generate a good one with:
#   openssl rand -hex 24 | sed 's/^/ember_/'
# Leave this blank to have Ember generate one and print it at first startup.
EMBER_API_KEY=ember_change_me_to_something_random

# Host port for the dashboard and the OTLP endpoint.
EMBER_PORT=8080

# Optional: path *inside the container* to a JSON pricing override file.
# You must also mount it — see examples/demo-agent/pricing.example.json.
EMBER_PRICING_PATH=
